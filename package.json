{
  "name": "ecommerce-frontend",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=22.22.2 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --grep-invert @visual",
    "test:visual": "playwright test --grep @visual",
    "verify": "npm run typecheck && npm run lint && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "@reduxjs/toolkit": "2.12.0",
    "@tanstack/react-table": "9.2.4",
    "@use-gesture/react": "10.3.1",
    "apexcharts": "7.5.1",
    "axios": "1.20.0",
    "bootstrap": "5.3.8",
    "chroma-js": "3.2.0",
    "classnames": "2.5.1",
    "cors": "2.8.6",
    "dayjs": "1.11.23",
    "embla-carousel-react": "8.6.0",
    "express": "5.2.1",
    "formik": "2.4.9",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "jwt-decode": "4.0.0",
    "lodash": "4.18.1",
    "lucide-react": "1.47.0",
    "next": "16.3.6",
    "passport": "0.7.0",
    "react": "19.3.0",
    "react-animate-height": "3.2.4",
    "react-apexcharts": "2.1.1",
    "react-colorful": "5.8.1",
    "react-datepicker": "9.1.0",
    "react-dom": "19.3.0",
    "react-imask": "7.6.1",
    "react-inner-image-zoom": "4.0.2",
    "react-range": "1.10.0",
    "react-redux": "9.3.0",
    "react-select": "5.10.2",
    "react-select-country-list": "2.2.3",
    "react-toastify": "11.1.0",
    "recharts": "3.10.1",
    "stripe": "22.6.2",
    "yup": "1.7.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/chroma-js": "3.1.2",
    "@types/lodash": "4.17.25",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "sass": "1.105.0",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
